{
  "name": "scoredit",
  "version": "0.1.0",
  "description": "Client-side music score viewer and editor: MuseScore, MusicXML and more, engraved with OpenSheetMusicDisplay one system at a time, with playback and note entry. No server, no framework.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:demo": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:corpus": "SCOREDIT_CORPUS=1 NODE_OPTIONS=--max-old-space-size=12288 vitest run src/formats/corpus.test.ts",
    "corpus": "node scripts/fetch-corpus.mjs",
    "prepare": "tsc -p tsconfig.json",
    "test:e2e": "node e2e/run.mjs",
    "test:rebuild": "node scripts/rebuild-corpus.mjs",
    "test:save": "node scripts/save-corpus.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "guitarpro-parser": "2.0.0",
    "opensheetmusicdisplay": "2.3.0",
    "spessasynth_core": "^4.4.10"
  },
  "devDependencies": {
    "happy-dom": "^20.10.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  }
}
